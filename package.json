{
  "name": "mern-practise",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack note board with an Express API and React frontend.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start"
  },
  "engines": {
    "node": ">=20"
  }
}